<Window x:Class="TYBIM.AutoBuild.AutoJoinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拓源數位｜自動接合" Width="596" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F0F5F8" Foreground="#172E45" FontFamily="Microsoft JhengHei"
        FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Teal" Color="#087B81"/>
        <SolidColorBrush x:Key="Muted" Color="#496376"/>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="ChoiceRow" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Background" Value="#F5F8FA"/>
            <Setter Property="Foreground" Value="#172E45"/>
            <Setter Property="BorderBrush" Value="#E2EBF0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Indicator" Width="17" Height="17" CornerRadius="4"
                                        BorderThickness="1.5" BorderBrush="#668091" Background="White" VerticalAlignment="Center">
                                    <Grid>
                                        <Path x:Name="Tick" Data="M 0,4 L 3,7 L 9,0" Stroke="White" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource Teal}" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#E6F5F4"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#A8D6D5"/>
                                <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource Teal}"/>
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource Teal}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Radio">
                                <Setter TargetName="Indicator" Property="CornerRadius" Value="9"/>
                                <Setter TargetName="Indicator" Property="Background" Value="White"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Radio"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="#3E9FA4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="#087B81"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource ChoiceRow}">
            <Setter Property="Tag" Value="Radio"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ChoiceRow}"/>
        <Style TargetType="Button" x:Key="Action">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#274659"/>
            <Setter Property="BorderBrush" Value="#CDDDE6"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#4AA7AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel KeyboardNavigation.TabNavigation="Cycle">
        <Border Padding="22,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#162D47" Offset="0"/>
                    <GradientStop Color="#126266" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="JoinArtwork" Width="52" Height="52" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="拓源數位" Foreground="#A9E4E0" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="自動接合" Foreground="White" FontWeight="Bold" FontSize="25"/>
                    <TextBlock x:Name="ViewScope" Foreground="#E2F5F5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="20,13,20,15">
            <TextBlock Text="執行方式" FontWeight="Bold" Margin="0,0,0,5"/>
            <UniformGrid Columns="2">
                <RadioButton x:Name="JoinMode" GroupName="Mode" Content="建立接合" IsChecked="True" Margin="0,0,5,0"
                             Checked="ModeChanged" AutomationProperties.HelpText="在所選品類之間建立幾何接合"/>
                <RadioButton x:Name="UnjoinMode" GroupName="Mode" Content="取消接合" Margin="5,0,0,0"
                             Checked="ModeChanged" AutomationProperties.HelpText="解除所選品類之間的既有幾何接合"/>
            </UniformGrid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="主體品類" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="擇一作為批次處理的主體" Foreground="{StaticResource Muted}" Margin="0,2,0,12"/>
                        <RadioButton x:Name="HostColumns" GroupName="Host" Content="柱（含結構柱）" IsChecked="True"/>
                        <RadioButton x:Name="HostFraming" GroupName="Host" Content="樑（結構構架）"/>
                        <RadioButton x:Name="HostWalls" GroupName="Host" Content="牆"/>
                        <RadioButton x:Name="HostFloors" GroupName="Host" Content="樓板" Margin="0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="全選" Style="{StaticResource Action}" Padding="7,1" MinHeight="24" Click="SelectAll"/>
                                <Button Content="清除" Style="{StaticResource Action}" Padding="7,1" MinHeight="24" Margin="5,0,0,0" Click="ClearAll"/>
                            </StackPanel>
                            <TextBlock Text="接合品類" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="SelectionCount" Foreground="{StaticResource Muted}" Margin="0,0,0,12"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <CheckBox x:Name="TargetColumns" Content="柱（含結構柱）" IsChecked="True" Click="TargetChanged"/>
                        <CheckBox x:Name="TargetFraming" Content="樑（結構構架）" IsChecked="True" Click="TargetChanged"/>
                        <CheckBox x:Name="TargetWalls" Content="牆" IsChecked="True" Click="TargetChanged"/>
                        <CheckBox x:Name="TargetFloors" Content="樓板" IsChecked="True" Click="TargetChanged" Margin="0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <DockPanel Margin="0,13,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="關閉" Style="{StaticResource Action}" MinWidth="72" MinHeight="36"
                            IsCancel="True" Margin="10,0,7,0"/>
                    <Button x:Name="RunButton" Style="{StaticResource Action}" MinWidth="114" MinHeight="36"
                            Foreground="White" FontWeight="Bold" IsDefault="True" Click="Run"/>
                </StackPanel>
                <TextBlock x:Name="ModeHint" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource Muted}"/>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</Window>
